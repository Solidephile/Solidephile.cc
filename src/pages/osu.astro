---
import { Icon } from "astro-icon/components";
import OsuPanel from "@/components/pages/osu/OsuPanel.svelte";
import { siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/common.css";

// 检查页面是否启用
if (!siteConfig.pages.osu) {
	return Astro.redirect("/404/");
}

const title = "osu! 数据统计";
const description = "个人 osu! 数据面板";
---

<MainGridLayout title={title} description={description}>
	<section class="page-shell">
		<!-- 标题面板 -->
		<header class="card-base page-header">
			<div class="page-heading">
				<div class="page-icon" aria-hidden="true">
					<Icon name="simple-icons:osu" />
				</div>
				<div>
					<h2>{title}</h2>
					<p>{description}</p>
				</div>
			</div>
		</header>

		<OsuPanel client:load />
	</section>
</MainGridLayout>
