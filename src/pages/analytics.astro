---
import { Icon } from "astro-icon/components";
import AnalyticsDashboard from "@/components/pages/analytics/AnalyticsDashboard.svelte";
import { siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/common.css";

// 检查页面是否启用
if (!siteConfig.pages.analytics) {
	return Astro.redirect("/404/");
}

const title = "站点统计";
const description = "本站访问数据看板";
---

<MainGridLayout title={title} description={description}>
	<!-- 统计页不需要被搜索引擎收录 -->
	<meta slot="head" name="robots" content="noindex, nofollow" />

	<section class="page-shell">
		<!-- 标题面板 -->
		<header class="card-base page-header">
			<div class="page-heading">
				<div class="page-icon" aria-hidden="true">
					<Icon is:inline name="material-symbols:analytics" />
				</div>
				<div>
					<h2>{title}</h2>
					<p>{description}</p>
				</div>
			</div>
		</header>

		<!--
			看板数据全部走服务端代理 /api/umami?view=dashboard&range=...
			（Umami 凭据只在服务端；响应带 5 分钟 CDN 缓存）
		-->
		<AnalyticsDashboard client:load />
	</section>
</MainGridLayout>
