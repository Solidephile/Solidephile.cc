---
import { musicPlayerConfig } from "@/config/musicConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { LYRIC_LEAD_MS } from "@/utils/lrc";

// MusicPlayer 的视图控制脚本只需要发一份：页面上可能同时有导航栏面板和侧栏
// 两个 widget，脚本内容除 widgetId 外完全一致。这里统一发一次，由脚本自己
// 遍历所有 .music-player-widget 初始化。
//
// 必须保持 is:inline 且不加 data-swup-ignore-script：@swup/scripts-plugin 会在
// content:replace 时重新执行全文档的内联脚本，侧栏 widget 换页后靠这个重跑完成
// 初始化；改成 bundled module 只会执行一次，会静默失效。
const config = musicPlayerConfig;

const viewConfigStr = JSON.stringify({
	showLyrics: config.showLyrics ?? true,
	// 与单曲页共用同一提前量，不在 inline 脚本中重复定义
	lyricLeadMs: LYRIC_LEAD_MS,
	i18n: {
		noPlaying: i18n(I18nKey.musicNoPlaying),
		lyrics: i18n(I18nKey.musicLyrics),
		noLyrics: i18n(I18nKey.musicNoLyrics),
		loadingLyrics: i18n(I18nKey.musicLoadingLyrics),
		failedLyrics: i18n(I18nKey.musicFailedLyrics),
		noSongs: i18n(I18nKey.musicNoSongs),
		error: i18n(I18nKey.musicError),
		play: i18n(I18nKey.musicPlay),
		pause: i18n(I18nKey.musicPause),
		noCover: i18n(I18nKey.musicNoCover),
		music: i18n(I18nKey.music),
	},
});
---

<!-- 播放列表条目模板：所有 widget 共用一份 -->
<template id="playlist-item-template">
<div class="playlist-item flex items-center gap-3 p-2 rounded-lg cursor-pointer hover:bg-neutral-50 dark:hover:bg-white/5 transition-colors group">
    <div class="w-8 h-8 rounded-md overflow-hidden shrink-0 relative bg-neutral-200 dark:bg-neutral-700">
        <img src="" class="item-cover w-full h-full object-cover" loading="lazy" alt="" />
        <!-- Active Indicator overlay with animated equalizer / play icon -->
        <div class="item-active-overlay absolute inset-0 bg-(--primary)/20 hidden items-center justify-center">
            <div class="eq-bars flex items-end gap-[2px] h-3.5">
                <span class="eq-bar w-[3px] bg-(--primary) rounded-sm"></span>
                <span class="eq-bar w-[3px] bg-(--primary) rounded-sm"></span>
                <span class="eq-bar w-[3px] bg-(--primary) rounded-sm"></span>
            </div>
            <svg class="eq-play-icon text-(--primary) hidden" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        </div>
    </div>
    <div class="flex-1 min-w-0">
        <div class="item-title text-xs font-bold text-neutral-700 dark:text-neutral-200 truncate group-hover:text-(--primary) transition-colors"></div>
        <div class="item-artist text-[10px] text-neutral-400 truncate"></div>
    </div>
</div>
</template>

<script define:vars={{ viewConfigStr }} is:inline>
(function () {
    var cfg = JSON.parse(viewConfigStr);

    var mgr = window.__musicManager;
    if (!mgr) return;

    var initScheduled = false;
    function scheduleInit() {
        if (initScheduled) return;
        initScheduled = true;

        var fired = false;
        function go() {
            if (fired) return;
            fired = true;
            document.removeEventListener('pointerdown', go, true);
            document.removeEventListener('keydown', go, true);
            mgr.init();
        }
        document.addEventListener('pointerdown', go, true);
        document.addEventListener('keydown', go, true);

        function afterLoad() {
            if (window.requestIdleCallback) window.requestIdleCallback(go, { timeout: 2000 });
            else setTimeout(go, 800);
        }
        if (document.readyState === 'complete') afterLoad();
        else window.addEventListener('load', afterLoad, { once: true });
    }

    function initWidget(widget) {
        // ── UI element refs ──────────────────────────────────────
        var ui = {
            widget: widget,
            loading: widget.querySelector('.music-loading'),
            cover: widget.querySelector('.music-cover'),
            title: widget.querySelector('.music-title'),
            titleViewport: widget.querySelector('.music-title-viewport'),
            artist: widget.querySelector('.music-artist'),
            progressBar: widget.querySelector('.progress-bar'),
            progressThumb: widget.querySelector('.progress-thumb'),
            progressContainer: widget.querySelector('.progress-container'),
            currentTime: widget.querySelector('.current-time'),
            totalTime: widget.querySelector('.total-time'),
            btnPlay: widget.querySelector('.btn-play'),
            iconPlay: widget.querySelector('.icon-play'),
            iconPause: widget.querySelector('.icon-pause'),
            btnPrev: widget.querySelector('.btn-prev'),
            btnNext: widget.querySelector('.btn-next'),
            btnRepeat: widget.querySelector('.btn-repeat'),
            iconRepeat: widget.querySelector('.icon-repeat'),
            iconRepeatOne: widget.querySelector('.icon-repeat-one'),
            iconShuffle: widget.querySelector('.icon-shuffle'),
            btnLrc: widget.querySelector('.btn-lrc-toggle'),
            iconLrcOn: widget.querySelector('.icon-lrc-on'),
            iconLrcOff: widget.querySelector('.icon-lrc-off'),
            lrcDrawer: widget.querySelector('.lrc-drawer'),
            lrcContainer: widget.querySelector('.lrc-container'),
            btnDrawer: widget.querySelector('.btn-drawer-toggle'),
            playlistDrawer: widget.querySelector('.playlist-drawer'),
            playlistContainer: widget.querySelector('.playlist-container'),
            itemTemplate: document.getElementById('playlist-item-template')
        };

        // Verify critical elements
        var _critical = [ui.btnPlay, ui.btnRepeat,
            ui.btnDrawer, ui.btnLrc, ui.lrcDrawer, ui.lrcContainer,
            ui.progressContainer, ui.btnNext, ui.btnPrev, ui.loading,
            ui.cover, ui.title, ui.artist, ui.playlistContainer, ui.itemTemplate];
        if (_critical.some(function(el) { return !el; })) return;

        // ── Local state (drawers, user scrolling, virtual scroll) ──
        var ITEM_H = 42;
        var OVERSCAN = 8;
        var local = {
            isUserScrolling: false,
            /** 正在拖进度条：此刻别让 fm:time 把预览位置拽回去 */
            isSeeking: false,
            scrollTimeout: null,
            /** 标题轮播：定时器 / 当前文字 / 上次量到的宽度 / 隐藏时的重试次数 */
            titleTimer: 0,
            titleFadeTimer: 0,
            fadeRaf: 0,
            titleText: '',
            titleWidth: 0,
            titleRetries: 0,
            resizeTimer: 0,
            destroyed: false,
            /** 控制器解析好的结构化歌词（{ t, text, translation, color, spans }） */
            lyrics: [],
            currentLrcIndex: -1,
            /** 歌词时钟：timeupdate 每 ~250ms 才来一次，靠它插值出连续时间 */
            lrcBase: 0,
            lrcBaseAt: 0,
            lrcPlaying: false,
            lrcRaf: 0,
            /** 呈现延迟（秒）：与单曲页同一个补偿量，见 readPresentationLatency */
            latency: 0,
            vs: {
                playlist: [],
                currentIndex: -1,
                renderedStart: -1,
                renderedEnd: -1,
                renderedEls: {},
                scrollRaf: 0,
                drawerOpen: false
            }
        };

        // ── UI update functions ──────────────────────────────────
        function setLoading(bool) {
            if (bool) {
                ui.loading.classList.remove('opacity-0', 'pointer-events-none');
            } else {
                ui.loading.classList.add('opacity-0', 'pointer-events-none');
            }
        }

        function updatePlayStateUI(isPlaying) {
            if (isPlaying) {
                ui.btnPlay.classList.add('bg-(--primary)', 'text-white', 'hover:brightness-110');
                ui.btnPlay.classList.remove('bg-(--btn-regular-bg)', 'hover:bg-(--btn-regular-bg-hover)', 'active:bg-(--btn-regular-bg-active)', 'text-(--primary)');
                ui.iconPlay.classList.add('hidden');
                ui.iconPause.classList.remove('hidden');
                ui.cover.style.animationPlayState = 'running';
                ui.btnPlay.setAttribute('aria-label', cfg.i18n.pause);
                ui.btnPlay.title = cfg.i18n.pause;
            } else {
                ui.btnPlay.classList.remove('bg-(--primary)', 'text-white', 'hover:brightness-110');
                ui.btnPlay.classList.add('bg-(--btn-regular-bg)', 'hover:bg-(--btn-regular-bg-hover)', 'active:bg-(--btn-regular-bg-active)', 'text-(--primary)');
                ui.iconPlay.classList.remove('hidden');
                ui.iconPause.classList.add('hidden');
                ui.cover.style.animationPlayState = 'paused';
                ui.btnPlay.setAttribute('aria-label', cfg.i18n.play);
                ui.btnPlay.title = cfg.i18n.play;
            }
            // Toggle eq-bars / play icon in playlist
            var activeItems = ui.playlistContainer.querySelectorAll('.playlist-item[aria-current="true"]');
            activeItems.forEach(function (item) {
                var eqBars = item.querySelector('.eq-bars');
                var playIcon = item.querySelector('.eq-play-icon');
                if (isPlaying) {
                    eqBars.classList.remove('hidden');
                    eqBars.classList.add('flex');
                    playIcon.classList.add('hidden');
                } else {
                    eqBars.classList.add('hidden');
                    eqBars.classList.remove('flex');
                    playIcon.classList.remove('hidden');
                }
            });
        }

        function updateModeUI(playMode) {
            var primaryColor = 'text-(--primary)';
            if (playMode === 0) {
                ui.btnRepeat.className = 'p-2 active:scale-95 transition-colors text-(--content-meta) hover:text-(--primary)';
                ui.iconRepeat.classList.remove('hidden');
                ui.iconRepeatOne.classList.add('hidden');
                ui.iconShuffle.classList.add('hidden');
            } else if (playMode === 1) {
                ui.btnRepeat.className = 'p-2 active:scale-95 transition-colors ' + primaryColor;
                ui.iconRepeat.classList.add('hidden');
                ui.iconRepeatOne.classList.remove('hidden');
                ui.iconShuffle.classList.add('hidden');
            } else {
                ui.btnRepeat.className = 'p-2 active:scale-95 transition-colors ' + primaryColor;
                ui.iconRepeat.classList.add('hidden');
                ui.iconRepeatOne.classList.add('hidden');
                ui.iconShuffle.classList.remove('hidden');
            }
        }

        /**
         * 上一首 / 下一首：队列里只剩一首时禁用。
         * 引擎的 playNext 是取模绕回，只有一首时点下去就是「重播同一首」，
         * 看起来像按钮坏了；单曲页那边一直是这个规则，这里对齐。
         */
        function updateSkipUI(count) {
            var single = !(count > 1);
            ui.btnPrev.disabled = single;
            ui.btnNext.disabled = single;
        }

        // ── 标题轮播（长歌名） ───────────────────────────────────
        // 省略号静止 → 开始左滚（左淡出从 0 长到 16px，跟着文字一起展开）→
        // 字滚完、空白经过左边缘时左淡出收掉（切换落在空白上，看不见）→
        // 无缝停在歌名开头 → 停一下 → 左淡出再从 0 长出、继续滚。
        // 参数都集中在这里。
        var TITLE_PAUSE_MS = 2000;         // 初始 / 循环点的静止时长
        var TITLE_SPEED = 30;              // px/s
        var TITLE_GAP_RATIO = 1 / 3;       // 尾部空白 = 标题区可见宽度 × 1/3

        /** 渐变宽度以 CSS 里的 --mt-fade 为准，脚本只负责让左侧从 0 长到它 */
        function titleFadeWidth() {
            var n = parseFloat(getComputedStyle(ui.titleViewport).getPropertyValue('--mt-fade'));
            return isNaN(n) ? 16 : n;
        }

        function stopTitleMarquee() {
            if (local.titleTimer) {
                clearTimeout(local.titleTimer);
                local.titleTimer = 0;
            }
            if (local.titleFadeTimer) {
                clearTimeout(local.titleFadeTimer);
                local.titleFadeTimer = 0;
            }
            if (local.fadeRaf) {
                cancelAnimationFrame(local.fadeRaf);
                local.fadeRaf = 0;
            }
            if (!ui.titleViewport) return;
            ui.titleViewport.classList.remove('is-marquee');
            ui.titleViewport.style.removeProperty('--mt-fade-l');
            var track = ui.title.querySelector('.mt-track');
            if (track) track.remove();
        }

        /**
         * 左侧淡出从 0 长到一个渐变宽。宽度取「左边缘已经切掉的文字量」：
         * 滚动刚开始时切掉 0px（不该有淡出），随文字左移按 30px/s 长到上限，
         * 所以视觉上是文字自己滑进渐变里，而不是渐变突然出现。
         */
        function growLeftFade() {
            var vp = ui.titleViewport;
            var max = titleFadeWidth();
            if (local.fadeRaf) cancelAnimationFrame(local.fadeRaf);
            vp.style.setProperty('--mt-fade-l', '0px');
            if (!window.requestAnimationFrame) {
                vp.style.setProperty('--mt-fade-l', max + 'px');
                return;
            }
            var t0 = performance.now();
            function step(now) {
                if (local.destroyed) return;
                // rAF 的时间戳可能比调用时的 performance.now() 早一点，别把宽度算成负数
                var cut = Math.max(0, ((now - t0) / 1000) * TITLE_SPEED);
                var fade = cut < max ? cut : max;
                vp.style.setProperty('--mt-fade-l', fade.toFixed(2) + 'px');
                local.fadeRaf = fade < max ? requestAnimationFrame(step) : 0;
            }
            local.fadeRaf = requestAnimationFrame(step);
        }

        /** 空白贴左：左边缘没有可淡出的字了，直接收掉（这一步看不见） */
        function hideLeftFade() {
            if (local.fadeRaf) {
                cancelAnimationFrame(local.fadeRaf);
                local.fadeRaf = 0;
            }
            ui.titleViewport.style.setProperty('--mt-fade-l', '0px');
        }

        /** 标题的唯一写入口：先恢复省略号状态，再按需排一次轮播 */
        function setTitleText(text) {
            stopTitleMarquee();
            local.titleText = text;
            local.titleRetries = 0;
            ui.title.innerText = text;
            if (!ui.titleViewport) return;
            local.titleWidth = ui.titleViewport.clientWidth;
            local.titleTimer = setTimeout(startTitleMarquee, TITLE_PAUSE_MS);
        }

        function startTitleMarquee() {
            local.titleTimer = 0;
            if (local.destroyed || !local.titleText || !ui.titleViewport) return;

            var width = ui.titleViewport.clientWidth;
            // 隐藏的 widget（display:none）量不到宽度：稍后重试，别当场放弃
            if (width === 0) {
                if (local.titleRetries++ < 20) {
                    local.titleTimer = setTimeout(startTitleMarquee, 500);
                }
                return;
            }
            // 系统开了「减少动态效果」就退回省略号，不滚
            if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            // 放得下就没有轮播的必要
            if (ui.title.scrollWidth <= width + 1) return;

            var textWidth = ui.title.scrollWidth;
            var gap = Math.round(width * TITLE_GAP_RATIO);

            var track = document.createElement('span');
            track.className = 'mt-track';
            for (var i = 0; i < 2; i++) {
                var seg = document.createElement('span');
                seg.className = 'mt-seg';
                seg.textContent = local.titleText;
                // 第二份只是为了让循环无缝，读屏别读两遍
                if (i > 0) seg.setAttribute('aria-hidden', 'true');
                var space = document.createElement('span');
                space.className = 'mt-gap';
                space.style.width = gap + 'px';
                track.appendChild(seg);
                track.appendChild(space);
            }

            ui.title.textContent = '';
            ui.title.appendChild(track);
            local.titleWidth = width;
            ui.titleViewport.classList.add('is-marquee');

            // 滚动距离 = 一份文字 + 一段空白；轨道宽度正好是它的 2 倍，
            // 所以 translateX(-50%) 恰好停在「下一份文字的开头贴左」的位置。
            // fadeAt：字全部越过左边缘的时刻（此时左边缘只剩空白，收起左淡出看不见）
            scrollTitleLoop(
                track,
                (textWidth / TITLE_SPEED) * 1000,
                (textWidth + gap) / TITLE_SPEED,
            );
        }

        function scrollTitleLoop(track, fadeAt, duration) {
            // 空白经过左边缘：左淡出到这里就收起
            if (local.titleFadeTimer) clearTimeout(local.titleFadeTimer);
            local.titleFadeTimer = setTimeout(function () {
                if (local.destroyed) return;
                hideLeftFade();
            }, fadeAt);

            // 用 CSS transition 推 transform：静止时零 rAF 开销，滚动本身也走合成层
            track.style.transition = 'none';
            track.style.transform = 'translateX(0)';
            void track.offsetWidth; // 强制回流，否则下一次 transition 不会生效
            track.style.transition = 'transform ' + duration.toFixed(2) + 's linear';
            track.style.transform = 'translateX(-50%)';

            // 每次从起点开始滚，左淡出都从 0 重新展开
            growLeftFade();

            local.titleTimer = setTimeout(function () {
                if (local.destroyed) return;
                // 到循环点：停一下再复位（左淡出此刻已经收掉了）
                local.titleTimer = setTimeout(function () {
                    if (local.destroyed) return;
                    scrollTitleLoop(track, fadeAt, duration);
                }, TITLE_PAUSE_MS);
            }, duration * 1000 + 80);
        }

        function updateTrackUI(track) {
            if (!track) return;
            setTitleText(track.name);
            ui.title.title = track.name;
            ui.artist.innerText = track.artist;
            ui.artist.title = track.artist;

            if (track.pic) {
                ui.cover.classList.add('opacity-0');
                ui.cover.src = track.pic;
                ui.cover.alt = track.name + ' - ' + track.artist;
            } else {
                ui.cover.src = '';
                ui.cover.classList.add('opacity-0');
                ui.cover.alt = cfg.i18n.noCover;
            }

            // Reset cover rotation
            ui.cover.classList.remove('animate-spin-slow');
            void ui.cover.offsetWidth;
            ui.cover.classList.add('animate-spin-slow');
            ui.cover.style.animationPlayState = 'paused';

            // Reset progress
            ui.progressBar.style.width = '0%';
            ui.progressThumb.style.left = '0%';
            ui.progressContainer.setAttribute('aria-valuenow', '0');
            ui.currentTime.innerText = '0:00';
            ui.totalTime.innerText = '0:00';
        }

        // ── Virtual scroll helpers (absolute-position based) ──────
        function vsApplyActiveStyle(el, isActive) {
            var overlay = el.querySelector('.item-active-overlay');
            var title = el.querySelector('.item-title');
            var eqBars = el.querySelector('.eq-bars');
            var playIcon = el.querySelector('.eq-play-icon');
            var isPlaying = mgr.getState().isPlaying;
            if (isActive) {
                el.classList.add('bg-neutral-100', 'dark:bg-white/10');
                el.setAttribute('aria-current', 'true');
                overlay.classList.remove('hidden');
                overlay.classList.add('flex');
                // 用 CSS 变量本身，不要在这里 getComputedStyle 取一次颜色存成字符串：
                // --primary 跟着 --hue（拖色相）和明暗主题变，取出来的值会定格在脚本启动那一刻。
                title.style.color = 'var(--primary)';
                if (isPlaying) {
                    eqBars.classList.remove('hidden');
                    eqBars.classList.add('flex');
                    playIcon.classList.add('hidden');
                } else {
                    eqBars.classList.add('hidden');
                    eqBars.classList.remove('flex');
                    playIcon.classList.remove('hidden');
                }
            } else {
                el.classList.remove('bg-neutral-100', 'dark:bg-white/10');
                el.removeAttribute('aria-current');
                overlay.classList.add('hidden');
                overlay.classList.remove('flex');
                title.style.color = '';
            }
        }

        function vsCreateItemEl(idx) {
            var vs = local.vs;
            var track = vs.playlist[idx];
            var clone = ui.itemTemplate.content.cloneNode(true);
            var itemEl = clone.querySelector('.playlist-item');
            var img = clone.querySelector('.item-cover');
            var title = clone.querySelector('.item-title');
            var artist = clone.querySelector('.item-artist');

            img.src = track.pic || '';
            img.alt = track.name + ' - ' + track.artist;
            title.innerText = track.name;
            artist.innerText = track.artist;

            itemEl.dataset.index = idx;
            itemEl.setAttribute('role', 'option');
            itemEl.setAttribute('aria-label', track.name + ' - ' + track.artist);
            itemEl.onclick = function () { mgr.playTrackByIndex(idx); };

            // Absolute positioning for virtual scroll
            itemEl.style.position = 'absolute';
            itemEl.style.left = '0';
            itemEl.style.right = '0';
            itemEl.style.top = (idx * ITEM_H) + 'px';
            itemEl.style.height = ITEM_H + 'px';

            if (idx === vs.currentIndex) {
                vsApplyActiveStyle(itemEl, true);
            }
            return clone;
        }

        function vsCommitRange() {
            var vs = local.vs;
            if (vs.playlist.length === 0 || !vs.drawerOpen) return;

            var container = ui.playlistContainer;
            var scrollTop = container.scrollTop;
            var viewHeight = container.clientHeight;
            var start = Math.max(0, Math.floor(scrollTop / ITEM_H) - OVERSCAN);
            var end = Math.min(vs.playlist.length, Math.ceil((scrollTop + viewHeight) / ITEM_H) + OVERSCAN);

            if (start === vs.renderedStart && end === vs.renderedEnd) return;

            if (vs.renderedStart === -1) {
                // First render: batch via fragment
                var frag = document.createDocumentFragment();
                for (var i = start; i < end; i++) {
                    frag.appendChild(vsCreateItemEl(i));
                }
                container.appendChild(frag);
            } else {
                // Incremental: remove out-of-range, add new items
                var oldEls = vs.renderedEls;
                for (var ri = vs.renderedStart; ri < vs.renderedEnd; ri++) {
                    if (ri < start || ri >= end) {
                        if (oldEls[ri]) { oldEls[ri].remove(); delete oldEls[ri]; }
                    }
                }
                for (var ai = start; ai < end; ai++) {
                    if (!oldEls[ai]) {
                        var newEl = vsCreateItemEl(ai);
                        var inserted = false;
                        for (var ni = ai + 1; ni < end; ni++) {
                            if (oldEls[ni]) {
                                container.insertBefore(newEl, oldEls[ni]);
                                inserted = true;
                                break;
                            }
                        }
                        if (!inserted) container.appendChild(newEl);
                        oldEls[ai] = newEl;
                    }
                }
            }

            // Rebuild reference map
            vs.renderedEls = {};
            var children = container.children;
            for (var ci = 0; ci < children.length; ci++) {
                var idx = parseInt(children[ci].dataset.index);
                if (!isNaN(idx)) vs.renderedEls[idx] = children[ci];
            }

            vs.renderedStart = start;
            vs.renderedEnd = end;
        }

        function vsRequestUpdate() {
            var vs = local.vs;
            if (vs.scrollRaf) return;
            vs.scrollRaf = requestAnimationFrame(function () {
                vs.scrollRaf = 0;
                vsCommitRange();
            });
        }

        function vsSetContainerHeight() {
            ui.playlistContainer.style.height = (local.vs.playlist.length * ITEM_H) + 'px';
        }

        function renderPlaylist(playlist, currentIndex) {
            var vs = local.vs;
            vs.playlist = playlist;
            vs.currentIndex = currentIndex;
            vs.renderedStart = -1;
            vs.renderedEnd = -1;
            vs.renderedEls = {};
            vs.drawerOpen = ui.playlistDrawer.style.gridTemplateRows === '1fr';
            ui.playlistContainer.innerHTML = '';
            if (vs.drawerOpen) {
                vsSetContainerHeight();
                vsCommitRange();
            }
        }

        function updatePlaylistActiveUI(currentIndex) {
            var vs = local.vs;
            var oldIndex = vs.currentIndex;
            vs.currentIndex = currentIndex;

            if (vs.renderedEls[oldIndex]) {
                vsApplyActiveStyle(vs.renderedEls[oldIndex], false);
            }

            if (currentIndex >= 0 && currentIndex < vs.playlist.length) {
                if (currentIndex < vs.renderedStart || currentIndex >= vs.renderedEnd) {
                    ui.playlistContainer.scrollTop = currentIndex * ITEM_H;
                    vsCommitRange();
                }
                if (vs.renderedEls[currentIndex]) {
                    vsApplyActiveStyle(vs.renderedEls[currentIndex], true);
                }
            }
        }

        /**
         * 歌词抽屉的「加载中 / 失败 / 无歌词」占位。
         * 与 StateMessage 的 inline 档保持同一套 class —— 这个脚本是 is:inline、
         * import 不到 Svelte 组件，只能手写同样的结构（改样式时两边一起改，
         * 见 HANDOVER §4.9）。
         */
        function lyricStateMarkup(title) {
            return '<div class="flex w-full flex-col items-center justify-center text-center py-8">' +
                '<p class="m-0 font-semibold text-black/80 dark:text-white/80 text-sm">' + title + '</p>' +
                '</div>';
        }

        /**
         * 渲染结构化歌词（解析在页面控制器里做，见 player.svelte.ts）。
         * 每行 = 原文（保留 {c:} 的行内颜色）+ 可选的翻译小字；点一行跳到那一句。
         */
        function renderLyricsUI(lyrics, status) {
            local.lyrics = Array.isArray(lyrics) ? lyrics : [];
            local.currentLrcIndex = -1;
            ui.lrcContainer.innerHTML = '';
            if (status === 'loading') {
                ui.lrcContainer.innerHTML = lyricStateMarkup(cfg.i18n.loadingLyrics);
                return;
            }
            if (status === 'failed') {
                ui.lrcContainer.innerHTML = lyricStateMarkup(cfg.i18n.failedLyrics);
                return;
            }
            if (local.lyrics.length === 0) {
                ui.lrcContainer.innerHTML = lyricStateMarkup(cfg.i18n.noLyrics);
                return;
            }

            local.lyrics.forEach(function (line, index) {
                var row = document.createElement('div');
                row.className = 'lrc-line transition-all duration-300 text-sm text-neutral-400 py-1 cursor-pointer hover:text-(--primary)';
                row.dataset.index = index;
                row.setAttribute('role', 'option');
                row.setAttribute('aria-label', line.translation ? line.text + ' · ' + line.translation : line.text);
                if (line.color) row.dataset.lineColor = line.color;

                var text = document.createElement('span');
                text.className = 'lrc-text block';
                var spans = line.spans && line.spans.length ? line.spans : [{ text: line.text, color: '' }];
                spans.forEach(function (span) {
                    var part = document.createElement('span');
                    // 空格 / 标点在解析时被拆到 lead、tail（它们不参与单曲页的渐变动画，
                    // 但这里是纯文本，要原样拼回去）
                    part.textContent = (span.lead || '') + span.text + (span.tail || '');
                    if (span.color) part.style.color = span.color;
                    text.appendChild(part);
                });
                row.appendChild(text);

                if (line.translation) {
                    var tr = document.createElement('span');
                    tr.className = 'lrc-tr block text-[0.8em] leading-snug opacity-80';
                    tr.textContent = line.translation;
                    row.appendChild(tr);
                }

                row.onclick = function () { mgr.seekToTime(line.t); };
                ui.lrcContainer.appendChild(row);
            });
        }

        /**
         * 与单曲页 `LyricsView` 的 `LINE_ARRIVE_LEAD_MS` 保持一致：
         * 逐字行提前这么多进入「当前行」，整句先就位、再开始逐字。
         * 这个脚本是 is:inline，import 不到 Svelte 组件，改那边记得同步这里。
         */
        var LRC_ARRIVE_LEAD_S = 0.25;

        /**
         * 呈现延迟（秒）：歌词要跟着「听到的声音」走，单曲页把 currentTime 减掉了
         * 输出延迟（`player.stageTime`），这里读同一组本地值（测量值 + 手动偏移），
         * 两处歌词才对得上。自动估计值只存在页面状态里，没校准过时这里是 0，
         * 差值在几十毫秒内。
         */
        function readPresentationLatency() {
            try {
                var measured = parseFloat(localStorage.getItem('music-output-latency') || '0') || 0;
                var offsetMs = parseFloat(localStorage.getItem('music-output-latency-offset') || '0') || 0;
                return Math.max(0, measured + offsetMs / 1000);
            } catch (err) {
                return 0;
            }
        }

        /** 这一行是否带逐字时间：与单曲页 `hasWordTiming` 的判定一致 */
        function hasWordTiming(line) {
            var spans = line.spans || [];
            if (spans.length <= 1) return false;
            for (var i = 0; i < spans.length; i++) {
                if (spans[i].t !== null && spans[i].t !== undefined) return true;
            }
            return false;
        }

        /**
         * 当前时间所在的行下标，与单曲页的 `currentIndex` 同一套规则：
         * 补上歌词提前量与输出延迟；逐字行提前 `LRC_ARRIVE_LEAD_S` 上位；
         * 第一句之前也把首句当作当前行（否则前奏整段没有任何高亮）。
         */
        function activeIndexAt(time) {
            var lines = local.lyrics;
            if (!lines.length) return -1;

            var t = time - local.latency + (cfg.lyricLeadMs || 0) / 1000;
            var index = -1;
            for (var i = 0; i < lines.length; i++) {
                if (lines[i].t <= t) index = i;
                else break;
            }

            while (index + 1 < lines.length) {
                var next = lines[index + 1];
                if (!hasWordTiming(next)) break;
                if (next.t - LRC_ARRIVE_LEAD_S > t) break;
                index++;
            }

            return Math.max(0, index);
        }

        // ── 歌词时钟 ─────────────────────────────────────────────
        // fm:time 来自 <audio> 的 timeupdate（约 4Hz），直接用它的 currentTime
        // 切行会晚最多 250ms；这里用墙钟在两次事件之间插值，切行时刻与单曲页一致。
        function syncLrcClock(time) {
            local.lrcBase = time;
            local.lrcBaseAt = performance.now();
            local.latency = readPresentationLatency();
        }

        function lrcNow() {
            return local.lrcPlaying
                ? local.lrcBase + (performance.now() - local.lrcBaseAt) / 1000
                : local.lrcBase;
        }

        function tickLrcClock() {
            if (!local.lrcPlaying || local.destroyed) return;
            updateLrcHighlight(activeIndexAt(lrcNow()));
            local.lrcRaf = requestAnimationFrame(tickLrcClock);
        }

        function startLrcClock() {
            if (local.lrcPlaying || local.destroyed) return;
            syncLrcClock(mgr.getState().currentTime);
            local.lrcPlaying = true;
            tickLrcClock();
        }

        function stopLrcClock() {
            if (!local.lrcPlaying) return;
            local.lrcPlaying = false;
            if (local.lrcRaf) cancelAnimationFrame(local.lrcRaf);
            local.lrcRaf = 0;
            syncLrcClock(mgr.getState().currentTime);
            updateLrcHighlight(activeIndexAt(lrcNow()));
        }

        // ── 歌词滚动的补间 ───────────────────────────────────────
        // 和单曲页 src/utils/scroll-tween.ts 是同一套参数与缓动。
        // 这个脚本必须保持 is:inline（swup 换页时会重跑），没法 import，
        // 所以这里是等价实现 —— 改那边记得同步这里。
        var LRC_SCROLL_MIN_MS = 560;
        var LRC_SCROLL_MAX_MS = 1200;
        var LRC_SCROLL_MS_PER_PX = 1;
        var lrcScrollFrames = new WeakMap();

        function animateLrcScroll(container, top) {
            var previous = lrcScrollFrames.get(container);
            if (previous) cancelAnimationFrame(previous);

            var from = container.scrollTop;
            var delta = top - from;
            if (Math.abs(delta) < 1) return;

            var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            var duration = reduced
                ? 0
                : Math.min(LRC_SCROLL_MAX_MS, LRC_SCROLL_MIN_MS + Math.abs(delta) * LRC_SCROLL_MS_PER_PX);

            if (duration === 0) { container.scrollTop = top; return; }

            var start = performance.now();
            function step(now) {
                var t = Math.min(1, (now - start) / duration);
                // easeInOutCubic：起步和收尾都软，中段才快
                var eased = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
                container.scrollTop = from + delta * eased;
                if (t < 1) lrcScrollFrames.set(container, requestAnimationFrame(step));
                else lrcScrollFrames.delete(container);
            }
            lrcScrollFrames.set(container, requestAnimationFrame(step));
        }

        function updateLrcHighlight(index) {
            if (index === local.currentLrcIndex) return;
            local.currentLrcIndex = index;

            var lines = ui.lrcContainer.querySelectorAll('.lrc-line');
            lines.forEach(function (line, i) {
                var active = i === index;
                var distance = Math.min(Math.abs(i - index), 5);

                line.classList.toggle('text-(--primary)', active);
                line.classList.toggle('font-bold', active);
                line.classList.toggle('text-base', active);
                line.classList.toggle('text-neutral-400', !active);
                line.classList.toggle('text-sm', !active);
                // 非当前行按距离淡出（和单曲页一致）；当前行保持不透明
                line.style.opacity = active ? '1' : String(Math.max(0.25, 1 - distance * 0.15));

                // 行内 {c:} 颜色只作用于非当前行：当前行统一用强调色
                var text = line.querySelector('.lrc-text');
                if (text) text.style.color = active ? '' : (line.dataset.lineColor || '');
            });

            // Auto-scroll unless user is scrolling
            if (index !== -1 && !local.isUserScrolling) {
                var line = ui.lrcContainer.querySelector('.lrc-line[data-index="' + index + '"]');
                if (line) {
                    var containerHeight = ui.lrcContainer.clientHeight;
                    var lineOffset = line.offsetTop;
                    var lineHeight = line.offsetHeight;
                    var targetScroll = lineOffset - (containerHeight / 2) + (lineHeight / 2);
                    animateLrcScroll(ui.lrcContainer, targetScroll);
                }
            }
        }

        // ── Full sync from manager state (for late-mount) ────────
        function syncAll() {
            var s = mgr.getState();
            if (!s.initialized) return;

            // Loading off
            setLoading(false);

            if (s.playlist.length === 0) {
                setTitleText(s.error || cfg.i18n.noSongs);
                return;
            }

            renderPlaylist(s.playlist, s.currentIndex);
            if (s.track) updateTrackUI(s.track);
            updatePlayStateUI(s.isPlaying);
            updateModeUI(s.playMode);
            updateSkipUI(s.playlist.length);

            // Progress
            if (s.duration > 0) {
                ui.progressBar.style.width = s.progress + '%';
                ui.progressThumb.style.left = s.progress + '%';
                ui.progressContainer.setAttribute('aria-valuenow', Math.round(s.progress).toString());
                ui.currentTime.innerText = s.currentTimeStr;
                ui.totalTime.innerText = s.durationStr;
            }

            // Lyrics
            renderLyricsUI(s.lyrics, s.lyrics.length > 0 ? 'loaded' : (s.lrcStatus || 'none'));
            syncLrcClock(s.currentTime);
            if (s.isPlaying) startLrcClock();
            else updateLrcHighlight(activeIndexAt(lrcNow()));

            // Cover image: if already set, show it
            if (s.track && s.track.pic && ui.cover.src && ui.cover.complete && ui.cover.naturalWidth > 0) {
                ui.cover.classList.remove('opacity-0');
            }
            // Update cover animation state to match play state
            ui.cover.style.animationPlayState = s.isPlaying ? 'running' : 'paused';
        }

        // ── Event listeners (fm:* from manager) ──────────────────
        var handlers = {};

        function on(name, fn) {
            handlers[name] = fn;
            window.addEventListener(name, fn);
        }

        on('fm:init', function (e) {
            var d = e.detail;
            setLoading(false);
            updateSkipUI(d.playlist.length);
            if (d.playlist.length > 0) {
                renderPlaylist(d.playlist, 0);
                updateModeUI(d.playMode);
            } else {
                setTitleText(cfg.i18n.noSongs);
            }
        });

        on('fm:track', function (e) {
            var d = e.detail;
            updateTrackUI(d.track);
            updatePlaylistActiveUI(d.index);
            // 换歌后时钟从新曲目的位置起算，别让上一首的时间继续算行号
            syncLrcClock(mgr.getState().currentTime);
            updateLrcHighlight(activeIndexAt(lrcNow()));
        });

        on('fm:play-state', function (e) {
            updatePlayStateUI(e.detail.isPlaying);
            if (e.detail.isPlaying) startLrcClock();
            else stopLrcClock();
        });

        on('fm:time', function (e) {
            var d = e.detail;
            // 拖动中不要覆盖预览：进度条由 previewSeek 管，这里只更新时间文字
            if (!local.isSeeking) {
                ui.progressBar.style.width = d.progress + '%';
                ui.progressThumb.style.left = d.progress + '%';
                ui.progressContainer.setAttribute('aria-valuenow', Math.round(d.progress).toString());
            }
            ui.currentTime.innerText = d.currentTimeStr;
            ui.totalTime.innerText = d.durationStr;
            // 以事件时间为新基准，再插值到下一帧；时钟没跑（刚开播）就顺手启动
            syncLrcClock(d.currentTime);
            if (!local.lrcPlaying && mgr.getState().isPlaying) startLrcClock();
            else updateLrcHighlight(activeIndexAt(lrcNow()));
        });

        on('fm:mode', function (e) {
            updateModeUI(e.detail.playMode);
        });

        on('fm:lyrics', function (e) {
            renderLyricsUI(e.detail.lyrics, e.detail.status);
            // 渲染完立刻对一次位置，不用等下一次 timeupdate
            syncLrcClock(mgr.getState().currentTime);
            updateLrcHighlight(activeIndexAt(lrcNow()));
        });

        on('fm:error', function (e) {
            setTitleText(e.detail.message || cfg.i18n.error);
        });

        // 窗口宽度变了，标题可用宽度也跟着变：重新量一次（防抖，免得拖拽时反复重启）
        on('resize', function () {
            if (local.resizeTimer) clearTimeout(local.resizeTimer);
            local.resizeTimer = setTimeout(function () {
                if (local.destroyed || !local.titleText) return;
                if (ui.titleViewport.clientWidth === local.titleWidth) return;
                setTitleText(local.titleText);
            }, 200);
        });

        // 字体换入后文字宽度会变：重排一次。多数时候这发生在初始停顿内，看不出来
        if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(function () {
                if (local.destroyed || !local.titleText) return;
                setTitleText(local.titleText);
            });
        }

        // ── Button click delegates ───────────────────────────────
        ui.btnPlay.addEventListener('click', function () { mgr.togglePlay(); });
        ui.btnNext.addEventListener('click', function () { mgr.playNext(); });
        ui.btnPrev.addEventListener('click', function () { mgr.playPrev(); });
        ui.btnRepeat.addEventListener('click', function () { mgr.cyclePlayMode(); });

        // 进度条：点一下定位，按住还能拖（和单曲页的播放条一致）。
        // 拖动期间只改视觉、松手才真的 seek：否则每移动一像素就是一个 Range 请求，
        // 而且 fm:time 会把预览位置又拽回去。
        function seekPercentFromEvent(e) {
            var rect = ui.progressContainer.getBoundingClientRect();
            var x = e.clientX - rect.left;
            return Math.min(Math.max(x / rect.width, 0), 1);
        }

        function previewSeek(percent) {
            var pct = percent * 100;
            ui.progressBar.style.width = pct + '%';
            ui.progressThumb.style.left = pct + '%';
            ui.progressContainer.setAttribute('aria-valuenow', Math.round(pct).toString());
        }

        function endSeek(e) {
            if (!local.isSeeking) return;
            local.isSeeking = false;
            try { ui.progressContainer.releasePointerCapture(e.pointerId); } catch (err) {}
            // 恢复过渡：正常播放时 fm:time 每 ~250ms 跳一次，靠它抹平
            ui.progressBar.style.transition = '';
            mgr.seek(seekPercentFromEvent(e));
            // 松手后立刻按新位置对齐歌词，不等下一次 timeupdate
            syncLrcClock(mgr.getState().currentTime);
            updateLrcHighlight(activeIndexAt(lrcNow()));
        }

        ui.progressContainer.addEventListener('pointerdown', function (e) {
            local.isSeeking = true;
            // 拖动期间关掉 width 过渡：过渡会让填充永远慢拇指一拍（每帧重新开始计时），
            // 看起来就是「拖到哪儿了，填充过一会儿才跟上」
            ui.progressBar.style.transition = 'none';
            // 指针移出元素后仍然要收到 move/up（触屏尤其需要），所以用指针捕获
            try { ui.progressContainer.setPointerCapture(e.pointerId); } catch (err) {}
            previewSeek(seekPercentFromEvent(e));
            e.preventDefault();
        });

        ui.progressContainer.addEventListener('pointermove', function (e) {
            if (!local.isSeeking) return;
            previewSeek(seekPercentFromEvent(e));
        });

        ui.progressContainer.addEventListener('pointerup', endSeek);
        ui.progressContainer.addEventListener('pointercancel', endSeek);
        // 兜底：指针捕获万一没生效（移出元素后松手），也必须在 window 上收尾，
        // 否则 isSeeking 会一直为 true、fm:time 再也不更新进度条
        window.addEventListener('pointerup', endSeek);

        // ── Drawer logic (local state) ───────────────────────────
        ui.btnLrc.addEventListener('click', function () {
            var isOpen = ui.lrcDrawer.style.gridTemplateRows === '1fr';
            if (isOpen) {
                ui.lrcDrawer.style.gridTemplateRows = '0fr';
                ui.lrcDrawer.classList.remove('opacity-100');
                ui.lrcDrawer.classList.add('opacity-0');
                ui.btnLrc.classList.remove('text-(--primary)');
                ui.btnLrc.classList.add('text-neutral-400');
                ui.iconLrcOn.classList.add('hidden');
                ui.iconLrcOff.classList.remove('hidden');
            } else {
                // Close playlist if open
                ui.playlistDrawer.style.gridTemplateRows = '0fr';
                ui.playlistDrawer.classList.remove('opacity-100');
                ui.playlistDrawer.classList.add('opacity-0');
                ui.btnDrawer.classList.remove('text-(--primary)');
                ui.btnDrawer.classList.add('text-neutral-400');

                ui.lrcDrawer.style.gridTemplateRows = '1fr';
                ui.lrcDrawer.classList.add('opacity-100');
                ui.lrcDrawer.classList.remove('opacity-0');
                ui.btnLrc.classList.add('text-(--primary)');
                ui.btnLrc.classList.remove('text-neutral-400');
                ui.iconLrcOn.classList.remove('hidden');
                ui.iconLrcOff.classList.add('hidden');
            }
        });

        ui.btnDrawer.addEventListener('click', function () {
            var isOpen = ui.playlistDrawer.style.gridTemplateRows === '1fr';
            if (isOpen) {
                ui.playlistDrawer.style.gridTemplateRows = '0fr';
                ui.playlistDrawer.classList.remove('opacity-100');
                ui.playlistDrawer.classList.add('opacity-0');
                ui.btnDrawer.classList.add('text-neutral-400');
                ui.btnDrawer.classList.remove('text-(--primary)');
                local.vs.drawerOpen = false;
            } else {
                // Close lyrics if open
                ui.lrcDrawer.style.gridTemplateRows = '0fr';
                ui.lrcDrawer.classList.remove('opacity-100');
                ui.lrcDrawer.classList.add('opacity-0');
                ui.btnLrc.classList.remove('text-(--primary)');
                ui.btnLrc.classList.add('text-neutral-400');
                ui.iconLrcOn.classList.add('hidden');
                ui.iconLrcOff.classList.remove('hidden');

                ui.playlistDrawer.style.gridTemplateRows = '1fr';
                ui.playlistDrawer.classList.add('opacity-100');
                ui.playlistDrawer.classList.remove('opacity-0');
                ui.btnDrawer.classList.remove('text-neutral-400');
                ui.btnDrawer.classList.add('text-(--primary)');
                local.vs.drawerOpen = true;

                // Render playlist after drawer transition settles
                if (local.vs.playlist.length > 0) {
                    requestAnimationFrame(function () {
                        vsSetContainerHeight();
                        vsCommitRange();
                    });
                }
            }
        });

        // ── Playlist virtual scroll listener ──────────────────────
        ui.playlistContainer.addEventListener('scroll', function () {
            vsRequestUpdate();
        });

        // ── Lyrics user scroll detection ─────────────────────────
        function resetScrollTimeout() {
            clearTimeout(local.scrollTimeout);
            local.scrollTimeout = setTimeout(function () {
                local.isUserScrolling = false;
                // Snap back to current lyric
                var index = activeIndexAt(lrcNow());
                if (index >= 0) {
                    var line = ui.lrcContainer.querySelector('.lrc-line[data-index="' + index + '"]');
                    if (line) {
                        var containerHeight = ui.lrcContainer.clientHeight;
                        var lineOffset = line.offsetTop;
                        var lineHeight = line.offsetHeight;
                        var targetScroll = lineOffset - (containerHeight / 2) + (lineHeight / 2);
                        animateLrcScroll(ui.lrcContainer, targetScroll);
                    }
                }
            }, 3000);
        }

        ui.lrcContainer.addEventListener('wheel', function () {
            local.isUserScrolling = true;
            resetScrollTimeout();
        });
        ui.lrcContainer.addEventListener('touchstart', function () {
            local.isUserScrolling = true;
            resetScrollTimeout();
        });

        // ── Cover image events ───────────────────────────────────
        ui.cover.addEventListener('load', function () {
            ui.cover.classList.remove('opacity-0');
        });
        ui.cover.addEventListener('error', function () {
            ui.cover.classList.add('opacity-0');
        });

        // ── Cleanup on DOM removal ───────────────────────────────
        var observer = new MutationObserver(function (mutations) {
            for (var i = 0; i < mutations.length; i++) {
                var removed = mutations[i].removedNodes;
                for (var j = 0; j < removed.length; j++) {
                    if (removed[j] === widget || (removed[j].contains && removed[j].contains(widget))) {
                        // Widget removed from DOM – clean up event listeners
                        Object.keys(handlers).forEach(function (name) {
                            window.removeEventListener(name, handlers[name]);
                        });
                        observer.disconnect();
                        clearTimeout(local.scrollTimeout);
                        local.destroyed = true;
                        if (local.titleTimer) clearTimeout(local.titleTimer);
                        if (local.titleFadeTimer) clearTimeout(local.titleFadeTimer);
                        if (local.fadeRaf) cancelAnimationFrame(local.fadeRaf);
                        if (local.lrcRaf) cancelAnimationFrame(local.lrcRaf);
                        local.lrcPlaying = false;
                        local.lrcRaf = 0;
                        if (local.resizeTimer) clearTimeout(local.resizeTimer);
                        return;
                    }
                }
            }
        });
        if (widget.parentNode) {
            observer.observe(widget.parentNode, { childList: true });
        }

        // ── Init: either sync existing state or trigger init ─────
        var currentState = mgr.getState();
        if (currentState.initialized) {
            // Manager already initialized (late mount) – sync all UI
            syncAll();
        } else {
            // First widget to mount – show loading and trigger init
            setLoading(true);
            scheduleInit();
        }
    }

    // 每个 widget 只初始化一次。导航栏那份 widget 在 swup 容器之外、DOM 不会被
    // 替换，而本脚本每次导航都会被重跑；侧栏 widget 会被整体替换，新 DOM 上没有
    // 这个标记，因此仍会正常重新初始化（旧实例由内部的 MutationObserver 清理）。
    function initAll() {
        var widgets = document.querySelectorAll('.music-player-widget');
        for (var i = 0; i < widgets.length; i++) {
            var w = widgets[i];
            if (w.dataset.musicInit === '1') continue;
            w.dataset.musicInit = '1';
            initWidget(w);
        }
    }

    initAll();
})();
</script>

<style>
    /* Now-playing equalizer bars —— 样式必须跟 <template> 待在同一个组件里：
       Astro 的作用域 class 是编译期打在模板元素上的，克隆出来的条目带的是本组件的
       hash，规则写在 MusicPlayer.astro 里会匹配不上。 */
    .eq-bars .eq-bar {
        animation: eq-bounce 1.2s ease-in-out infinite;
    }
    .eq-bars .eq-bar:nth-child(1) { animation-duration: 0.8s; }
    .eq-bars .eq-bar:nth-child(2) { animation-duration: 0.6s; animation-delay: 0.15s; }
    .eq-bars .eq-bar:nth-child(3) { animation-duration: 1.0s; animation-delay: 0.3s; }

    @keyframes eq-bounce {
        0%, 100% { height: 4px; }
        50%      { height: 14px; }
    }
</style>
