---
import { musicPlayerConfig } from "@/config/musicConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { MusicTrack } from "@/types/music";

interface Props {
	/**
	 * 默认播放队列（本地曲目，由 Layout 从 music collection 构建）。
	 * 有它就不再默认拉网易云歌单；歌单只在按下云端曲目时才换上。
	 */
	localPlaylist?: MusicTrack[];
}

/**
 * 曲目来源只有一处：content collection（Layout 构建好传进来）。
 * 没有这里的老配置回退——以前 `musicPlayerConfig.local.playlist` 里那份占位数据
 * 会在 collection 为空时被当成真曲子去播，是个静默的坑。
 */
const { localPlaylist = [] } = Astro.props;
const config = musicPlayerConfig;

/**
 * 引擎脚本（is:inline）内部用 name / artist / url / pic 这套旧字段名，那是它的私有
 * 协议；边界上只在这里转换一次，外面的世界一律是 `MusicTrack`。
 */
const enginePlaylist = localPlaylist.map((track) => ({
	name: track.title,
	artist: track.artist,
	url: track.audio,
	pic: track.cover,
	lrc: track.lrc,
	duration: track.duration,
	bpm: track.bpm,
	offset: track.offset,
	slug: track.slug,
}));

const managerConfigStr = JSON.stringify({
	meting: config.meting,
	localPlaylist: enginePlaylist,
	volume: config.volume ?? 0.7,
	playMode: config.playMode ?? "list",
	showLyrics: config.showLyrics ?? true,
	mediaSession: {
		enable: config.mediaSession?.enable ?? true,
		album: config.mediaSession?.album ?? "Solidephile",
		fallbackArtwork:
			config.mediaSession?.fallbackArtwork ??
			"/assets/images/music-artwork.png",
	},
	i18n: {
		noPlaying: i18n(I18nKey.musicNoPlaying),
		lyrics: i18n(I18nKey.musicLyrics),
		playMode: i18n(I18nKey.musicPlayMode),
		prev: i18n(I18nKey.musicPrev),
		next: i18n(I18nKey.musicNext),
		playlist: i18n(I18nKey.musicPlaylist),
		noLyrics: i18n(I18nKey.musicNoLyrics),
		loadingLyrics: i18n(I18nKey.musicLoadingLyrics),
		failedLyrics: i18n(I18nKey.musicFailedLyrics),
		noSongs: i18n(I18nKey.musicNoSongs),
		error: i18n(I18nKey.musicError),
		play: i18n(I18nKey.musicPlay),
		pause: i18n(I18nKey.musicPause),
		progress: i18n(I18nKey.musicProgress),
		noCover: i18n(I18nKey.musicNoCover),
	},
});
---

<script is:inline data-swup-ignore-script define:vars={{ managerConfigStr }}>
(function () {
    // Singleton guard – only create once
    if (window.__musicManager) return;

    var config = JSON.parse(managerConfigStr);

    // ── Helpers ──────────────────────────────────────────────
    function formatTime(seconds) {
        if (!seconds || isNaN(seconds)) return '0:00';
        var min = Math.floor(seconds / 60);
        var sec = Math.floor(seconds % 60);
        return min + ':' + (sec < 10 ? '0' : '') + sec;
    }

    // ── Audio element (persistent, attached to body) ────────
    var audio = createAudioElement();

    function createAudioElement() {
        var el = document.createElement('audio');
        el.crossOrigin = 'anonymous';
        el.style.display = 'none';
        el.preload = 'none'; // 阻止浏览器预加载和自动恢复播放
        document.body.appendChild(el);
        el.pause(); // 确保不自动播放
        bindAudio(el);
        return el;
    }

    /**
     * 换一个全新的音频元素。
     *
     * createMediaElementSource 一旦把元素接进图谱就撤不回来，而网易云的地址没有 CORS，
     * 走图谱会被静音（不是报错）。所以从本地曲目切到歌单时必须换元素，让歌单回到普通
     * 播放路径；页面侧收到 `fm:element` 后重新接时钟。
     */
    function replaceAudio() {
        var previous = audio;
        previous.pause();
        previous.removeAttribute('src');
        previous.load();
        previous.remove();

        audio = createAudioElement();
        audio.volume = state.volume;
        emit('fm:element', { element: audio });
    }

    // ── State ────────────────────────────────────────────────
    var loadVersion = 0; // incremented on each loadTrack to discard stale play() results
    var state = {
        playlist: [],
        currentIndex: 0,
        isPlaying: false,
        playMode: 0, // 0: list, 1: one, 2: random
        // 音量全站固定（配置里的 volume）：站点不再提供音量 / 静音的入口
        volume: config.volume || 0.7,
        lyrics: [],
        /** 当前曲目的原始 LRC 文本（控制器靠它解析，也用于首帧竞态补解析） */
        lrcRaw: '',
        lrcStatus: 'none',
        initialized: false,
        initializing: false,
        error: null
    };

    // Map config playMode string to number
    if (config.playMode === 'random') state.playMode = 2;
    else if (config.playMode === 'one') state.playMode = 1;
    else state.playMode = 0;

    // ── Media Session（系统媒体卡 / 锁屏）────────────────────
    // 统一走 W3C Media Session API：Windows 11 音量弹窗的媒体卡、Edge 工具栏的媒体
    // 控制中心、Android 媒体通知、iOS 锁屏都读它。浏览器把会话注册成系统 SMTC 之后，
    // 标题 / 歌手 / 封面 / 播放状态 / 上下一首 / 进度拖动都由这一份数据驱动。
    // 控制回调全部转给下面那几个函数，和导航栏 widget 的按钮是同一个入口，
    // 所以时钟、延迟补偿、歌词推进都不受影响。
    var mediaConfig = config.mediaSession || {};
    var mediaSession = null;
    try {
        if (mediaConfig.enable !== false && 'mediaSession' in navigator) {
            mediaSession = navigator.mediaSession;
        }
    } catch (e) {
        mediaSession = null;
    }
    var hasMediaMetadata = typeof MediaMetadata === 'function';
    var fallbackArtwork = mediaArtworkUrl(mediaConfig.fallbackArtwork || '');
    /** 封面探测序号：换歌后旧图加载失败不能把新歌的封面换掉 */
    var artworkProbeSeq = 0;

    function mediaArtworkUrl(url) {
        if (!url) return '';
        var absolute = '';
        try {
            absolute = new URL(url, location.href).href;
        } catch (e) {
            return '';
        }
        // 网易云的部分封面是 http，https 页面里会被当成混合内容拦掉
        return absolute.replace(/^http:/, 'https:');
    }

    function mediaArtworkType(url) {
        var match = /\.(png|jpe?g|webp|gif|avif)(?:[?#]|$)/i.exec(url);
        if (!match) return '';
        var ext = match[1].toLowerCase();
        if (ext === 'jpg') ext = 'jpeg';
        return 'image/' + ext;
    }

    function mediaArtworkEntry(url) {
        var entry = { src: url, sizes: '512x512' };
        var type = mediaArtworkType(url);
        if (type) entry.type = type;
        return entry;
    }

    /**
     * 写入当前曲目的元数据。
     *
     * 有封面就只用封面（两张 512 的图并列时系统可能挑错，所以失败时再整体换回退图）；
     * 没有封面 / 封面加载失败才用默认图。
     */
    function applyMediaMetadata(track) {
        if (!mediaSession || !hasMediaMetadata || !track) return;

        var cover = mediaArtworkUrl(track.pic || '');
        var artwork = [];
        if (cover && cover !== fallbackArtwork) {
            artwork.push(mediaArtworkEntry(cover));
            probeMediaArtwork(track, cover);
        } else if (fallbackArtwork) {
            artwork.push(mediaArtworkEntry(fallbackArtwork));
        }

        try {
            mediaSession.metadata = new MediaMetadata({
                title: track.name || '',
                artist: track.artist || '',
                album: mediaConfig.album || '',
                artwork: artwork
            });
        } catch (e) {
            // 老浏览器 / 字段不合法：媒体卡能力是加分项，失败不影响播放
        }
    }

    /** 封面加载失败（防盗链、混合内容、404）时退回默认图 */
    function probeMediaArtwork(track, cover) {
        if (!fallbackArtwork) return;
        var seq = ++artworkProbeSeq;
        var image = new Image();
        image.onerror = function () {
            if (seq !== artworkProbeSeq) return;
            if (state.playlist[state.currentIndex] !== track) return;
            try {
                mediaSession.metadata = new MediaMetadata({
                    title: track.name || '',
                    artist: track.artist || '',
                    album: mediaConfig.album || '',
                    artwork: [mediaArtworkEntry(fallbackArtwork)]
                });
            } catch (e) {
                // 忽略：保持原来的封面就行
            }
        };
        image.src = cover;
    }

    function syncMediaPlayback(isPlaying) {
        if (!mediaSession) return;
        mediaSession.playbackState = isPlaying ? 'playing' : 'paused';
    }

    /** 进度位置：系统媒体卡的进度条 / 拖动手柄读这个 */
    function updateMediaPosition() {
        if (!mediaSession || typeof mediaSession.setPositionState !== 'function') return;
        var dur = isFinite(audio.duration) ? audio.duration : 0;
        if (dur <= 0) return;
        var position = Math.min(Math.max(audio.currentTime || 0, 0), dur);
        try {
            mediaSession.setPositionState({
                duration: dur,
                playbackRate: audio.playbackRate || 1,
                position: position
            });
        } catch (e) {
            // 某些浏览器对参数更严格，失败就算了
        }
    }

    /** 队列结束 / 主动停止：把媒体卡清掉，免得一直停在最后一首 */
    function clearMediaSession() {
        if (!mediaSession) return;
        try {
            mediaSession.metadata = null;
            mediaSession.playbackState = 'none';
        } catch (e) {
            // 某些浏览器对 metadata 的赋值更严格，忽略
        }
        if (typeof mediaSession.setPositionState === 'function') {
            try {
                mediaSession.setPositionState();
            } catch (e) {
                // 已清空，忽略
            }
        }
    }

    function setupMediaHandlers() {
        if (!mediaSession || typeof mediaSession.setActionHandler !== 'function') return;

        var handlers = {
            play: function () {
                if (audio.paused) togglePlay();
            },
            pause: function () {
                if (!audio.paused) togglePlay();
            },
            previoustrack: function () {
                playPrev();
            },
            nexttrack: function () {
                // 手动切歌：和 widget 的「下一首」完全一致（单曲页会跟过去）
                playNext(false);
            },
            stop: function () {
                if (!audio.paused) audio.pause();
                clearMediaSession();
            },
            seekto: function (details) {
                if (details && isFinite(details.seekTime)) seekToTime(details.seekTime);
            },
            seekbackward: function (details) {
                var step = details && isFinite(details.seekOffset) ? details.seekOffset : 10;
                seekToTime(audio.currentTime - step);
            },
            seekforward: function (details) {
                var step = details && isFinite(details.seekOffset) ? details.seekOffset : 10;
                seekToTime(audio.currentTime + step);
            }
        };

        Object.keys(handlers).forEach(function (action) {
            try {
                mediaSession.setActionHandler(action, handlers[action]);
            } catch (e) {
                // 不支持的 action 会抛，忽略即可
            }
        });
    }

    setupMediaHandlers();

    // ── Event helpers ────────────────────────────────────────
    function emit(name, detail) {
        window.dispatchEvent(new CustomEvent(name, { detail: detail || {} }));
    }

    // ── Meting fetch ─────────────────────────────────────────
    var metingCache = null;
    /** 歌单落盘缓存：接口在国内不稳，刷新页面后不必再等一次 */
    var METING_CACHE_KEY = 'music-meting-cache-v1';
    /** 缓存有效期：CDN 直链会过期，太久反而播不了，所以只保半小时 */
    var METING_CACHE_TTL = 30 * 60 * 1000;

    function readMetingCache(maxAge) {
        try {
            var raw = localStorage.getItem(METING_CACHE_KEY);
            if (!raw) return null;

            var data = JSON.parse(raw);
            if (!data || !Array.isArray(data.tracks) || data.tracks.length === 0) {
                return null;
            }
            if (maxAge && Date.now() - (data.at || 0) > maxAge) return null;

            return data.tracks;
        } catch (e) {
            return null;
        }
    }

    function writeMetingCache(tracks) {
        try {
            var raw = JSON.stringify({ at: Date.now(), tracks: tracks });
            // 太大就不落盘（歌单里可能带歌词），免得撑爆 localStorage
            if (raw.length < 1500000) localStorage.setItem(METING_CACHE_KEY, raw);
        } catch (e) {
            // 隐私模式写不进去就算了
        }
    }

    async function fetchMetingData() {
        if (metingCache) return metingCache;
        if (!config.meting) return [];

        var cached = readMetingCache(METING_CACHE_TTL);
        if (cached) {
            metingCache = cached;
            return metingCache;
        }

        var m = config.meting;
        var apis = [m.api].concat(m.fallbackApis || []);
        var lastError = null;

        for (var i = 0; i < apis.length; i++) {
            var baseApi = apis[i];
            if (!baseApi) continue;
            try {
                var fetchUrl = baseApi
                    .replace(':server', m.server)
                    .replace(':type', m.type)
                    .replace(':id', m.id)
                    .replace(':r', Math.random());
                if (m.auth) fetchUrl += '&auth=' + m.auth;

                var res = await fetch(fetchUrl);
                if (!res.ok) throw new Error('HTTP ' + res.status);
                var data = await res.json();

                if (Array.isArray(data) && data.length > 0) {
                    metingCache = data.map(function (item) {
                        return {
                            name: item.title || item.name || 'Unknown',
                            artist: item.author || item.artist || 'Unknown',
                            url: item.url,
                            pic: item.pic || item.cover || '',
                            lrc: item.lrc
                        };
                    });
                    writeMetingCache(metingCache);
                    return metingCache;
                }
            } catch (e) {
                lastError = e;
                console.warn('Meting API failed for ' + baseApi, e);
            }
        }

        // 拉不到就退回旧缓存（过期也先用着，总比空列表好）
        var stale = readMetingCache(0);
        if (stale) {
            metingCache = stale;
            return metingCache;
        }

        throw lastError || new Error('All Meting APIs failed');
    }

    // ── Lyrics ───────────────────────────────────────────────
    /**
     * 只负责拿到「原始 LRC 文本」，解析交给页面控制器（那边能 import lrc.ts）。
     * 引擎里再写一份解析器就是第三份实现了，所以这里连解析都不做。
     * 解析结果由控制器回调 setLyrics() 写回 state.lyrics，两套 UI 都读它。
     */
    function loadLyrics(track) {
        state.lyrics = [];
        state.lrcRaw = '';
        state.lrcStatus = 'none';

        if (!track.lrc) {
            emit('fm:lyrics', { lyrics: [], status: 'none' });
            return;
        }

        var isLrcUrl = /^(https?:)?\/\//.test(track.lrc)
            || track.lrc.startsWith('/')
            || /\.(lrc|txt)(\?|#|$)/i.test(track.lrc);

        if (isLrcUrl) {
            state.lrcStatus = 'loading';
            emit('fm:lyrics', { lyrics: [], status: 'loading' });
            fetch(track.lrc)
                .then(function (r) { return r.text(); })
                .then(function (text) {
                    state.lrcRaw = text;
                    state.lrcStatus = 'loaded';
                    emit('fm:lyrics-raw', { raw: text });
                })
                .catch(function () {
                    state.lrcRaw = '';
                    state.lrcStatus = 'failed';
                    emit('fm:lyrics', { lyrics: [], status: 'failed' });
                });
            return;
        }

        state.lrcRaw = track.lrc;
        state.lrcStatus = 'loaded';
        emit('fm:lyrics-raw', { raw: track.lrc });
    }

    /** 页面控制器解析完回写（只由控制器调用） */
    function setLyrics(lines) {
        state.lyrics = Array.isArray(lines) ? lines : [];
        emit('fm:lyrics', {
            lyrics: state.lyrics,
            status: state.lyrics.length > 0 ? 'loaded' : 'none'
        });
    }

    var currentTrackUrls = [];
    var currentTrackUrlIndex = 0;
    var errorSkipTimeout = null;

    function tryPlayCurrentTrackUrl(autoPlay, ver) {
        if (ver !== loadVersion) return;
        var playUrl = currentTrackUrls[currentTrackUrlIndex];
        audio.src = playUrl;
        state.autoPlay = !!autoPlay;

        if (autoPlay) {
            audio.play().then(function () {
                if (ver !== loadVersion) return; // stale, discard
                state.isPlaying = true;
                state.error = null;
                emit('fm:play-state', { isPlaying: true });
            }).catch(function (e) {
                if (ver !== loadVersion) return; // stale, discard
                if (e.name === 'AbortError') return; // interrupted by new load
                console.warn('Autoplay blocked:', e);
            });
        } else {
            state.isPlaying = false;
            emit('fm:play-state', { isPlaying: false });
        }
    }

    // ── Track loading ────────────────────────────────────────
    function loadTrack(index, autoPlay, auto) {
        if (index < 0 || index >= state.playlist.length) return;
        state.currentIndex = index;
        var track = state.playlist[index];
        var ver = ++loadVersion;

        if (errorSkipTimeout) {
            clearTimeout(errorSkipTimeout);
            errorSkipTimeout = null;
        }

        currentTrackUrls = [track.url];
        currentTrackUrlIndex = 0;
        state.autoPlay = !!autoPlay;

        var matchId = track.url.match(/[?&]id=([^&]+)/);
        var matchServer = track.url.match(/[?&]server=([^&]+)/);
        if (matchId && matchServer && config.meting && config.meting.fallbackApis) {
            config.meting.fallbackApis.forEach(function (fallback) {
                var fallbackUrl = fallback
                    .replace(':server', matchServer[1])
                    .replace(':type', 'url')
                    .replace(':id', matchId[1]);
                if (currentTrackUrls.indexOf(fallbackUrl) === -1) {
                    currentTrackUrls.push(fallbackUrl);
                }
            });
        }

        loadLyrics(track);

        emit('fm:track', { index: index, track: track, autoPlay: !!autoPlay, auto: !!auto });

        // 系统媒体卡：歌名 / 歌手 / 封面跟着换；播放状态由元素事件同步
        applyMediaMetadata(track);

        tryPlayCurrentTrackUrl(autoPlay, ver);
    }

    // ── Playback controls ────────────────────────────────────
    function togglePlay() {
        if (audio.paused) {
            audio.play().then(function () {
                state.isPlaying = true;
                emit('fm:play-state', { isPlaying: true });
            }).catch(function (e) {
                if (e.name === 'AbortError') return;
                console.warn('Playback failed:', e);
            });
        } else {
            audio.pause();
            state.isPlaying = false;
            emit('fm:play-state', { isPlaying: false });
        }
    }

    function playNext(auto) {
        if (state.playMode === 1 && auto) {
            // 单曲循环：就地从头再来。刻意不发事件——既没换曲也没停，页面侧的
            // 播放状态本来就是对，广播反而多余（页面侧只认 fm:play-state）。
            audio.currentTime = 0;
            audio.play();
            return;
        }
        var nextIndex;
        if (state.playMode === 2) {
            nextIndex = Math.floor(Math.random() * state.playlist.length);
        } else {
            nextIndex = (state.currentIndex + 1) % state.playlist.length;
        }
        loadTrack(nextIndex, true, !!auto);
    }

    function playPrev() {
        var prevIndex;
        if (state.playMode === 2) {
            prevIndex = Math.floor(Math.random() * state.playlist.length);
        } else {
            prevIndex = (state.currentIndex - 1 + state.playlist.length) % state.playlist.length;
        }
        loadTrack(prevIndex, true, false);
    }

    function setPlayMode(mode) {
        state.playMode = mode;
        emit('fm:mode', { playMode: mode });
    }

    function cyclePlayMode() {
        setPlayMode((state.playMode + 1) % 3);
    }

    function seek(percent) {
        if (!audio.duration) return;
        audio.currentTime = Math.max(0, Math.min(1, percent)) * audio.duration;
    }

    function seekToTime(time) {
        // 元数据还没到时 duration 是 NaN；直接设 currentTime 会变成“待生效的跳转”，
        // 播放时浏览器会先加载再跳过去，所以这里不要因为 duration 未知就直接返回
        var dur = isFinite(audio.duration) ? audio.duration : 0;
        var target = Math.max(0, dur > 0 ? Math.min(time, dur) : time);
        try {
            audio.currentTime = target;
        } catch (e) {
            console.warn('Seek failed:', e);
        }
    }

    function playTrackByIndex(index) {
        if (index === state.currentIndex) {
            // 暂停 / 继续只归播放键：点当前这一条只负责「继续」。
            // 以前是「在放就 pause、否则 loadTrack」，所以暂停后再点会从头重播。
            if (audio.paused) togglePlay();
            return;
        }
        loadTrack(index, true);
    }

    /**
     * 整份替换队列（页面级播放 / 索引页切来源都走这里，按需由调用方保证时序）。
     *
     * `crossOrigin` 只有本地曲目（R2 放行了本站来源）才开，开了才能接频谱；
     * 网易云那边的地址没有 CORS，开了会直接加载失败。
     */
    function setPlaylist(tracks, index, autoPlay, crossOrigin) {
        if (errorSkipTimeout) {
            clearTimeout(errorSkipTimeout);
            errorSkipTimeout = null;
        }

        state.playlist = Array.from(tracks || []);
        state.currentIndex = 0;
        state.initialized = true;
        state.lyrics = [];
        state.lrcRaw = '';
        state.lrcStatus = 'none';

        if (crossOrigin) {
            audio.crossOrigin = 'anonymous';
        } else {
            // 歌单没有 CORS：元素要是已经被接进图谱了，就换一个新的（见 replaceAudio）
            replaceAudio();
            audio.crossOrigin = null;
            audio.removeAttribute('crossorigin');
        }

        if (state.playlist.length === 0) {
            audio.pause();
            audio.removeAttribute('src');
            state.isPlaying = false;
            clearMediaSession();
            emit('fm:init', {
                playlist: [],
                playMode: state.playMode
            });
            emit('fm:play-state', { isPlaying: false });
            return;
        }

        audio.volume = state.volume;

        emit('fm:init', {
            playlist: state.playlist,
            playMode: state.playMode
        });

        var start = Math.max(0, Math.min(Number(index) || 0, state.playlist.length - 1));
        loadTrack(start, !!autoPlay);
    }

    // ── Audio events → broadcast ─────────────────────────────
    function bindAudio(el) {
    el.addEventListener('timeupdate', function () {
        if (isNaN(el.duration)) return;
        var ct = el.currentTime;
        var dur = el.duration;
        var pct = (ct / dur) * 100;

        emit('fm:time', {
            currentTime: ct,
            duration: dur,
            progress: pct,
            currentTimeStr: formatTime(ct),
            durationStr: formatTime(dur)
        });

        updateMediaPosition();
    });

    // 播放状态也同步给系统媒体卡（暂停保留卡片，只是状态变成 paused）
    el.addEventListener('play', function () {
        syncMediaPlayback(true);
    });
    el.addEventListener('pause', function () {
        syncMediaPlayback(false);
    });
    el.addEventListener('loadedmetadata', function () {
        updateMediaPosition();
    });
    el.addEventListener('seeked', function () {
        updateMediaPosition();
    });

    el.addEventListener('ended', function () {
        // 单曲队列（页面级播放）放完就停，别自己重新循环；列表循环才续下一首
        if (state.playlist.length < 2 && state.playMode !== 1) {
            state.isPlaying = false;
            emit('fm:play-state', { isPlaying: false });
            // 队列真的结束了：清掉系统媒体卡，而不是留一张「暂停」的假象
            clearMediaSession();
            return;
        }
        playNext(true);
    });

    el.addEventListener('error', function () {
        var ver = loadVersion;

        // 为了频谱给元素加了 crossOrigin：CDN 不放行当前来源时元素会直接加载失败
        // （不是静音）。去掉属性重试一次，放弃频谱保住播放。
        if (el.crossOrigin) {
            console.warn('Audio CORS failed, retrying without crossOrigin');
            var wantPlay = state.autoPlay;
            el.crossOrigin = null;
            el.removeAttribute('crossorigin');
            el.removeAttribute('src');
            currentTrackUrlIndex = 0;
            emit('fm:cors-failed', {});
            tryPlayCurrentTrackUrl(wantPlay, ver);
            return;
        }

        if (currentTrackUrlIndex < currentTrackUrls.length - 1) {
            currentTrackUrlIndex++;
            console.warn('Playback failed, trying fallback URL: ' + currentTrackUrls[currentTrackUrlIndex]);
            tryPlayCurrentTrackUrl(true, ver);
        } else {
            state.error = 'Audio playback error';
            emit('fm:error', { message: '播放失败，即将自动跳过...' });

            if (errorSkipTimeout) clearTimeout(errorSkipTimeout);
            errorSkipTimeout = setTimeout(function () {
                if (ver === loadVersion) {
                    playNext(true);
                }
            }, 2000);
        }
    });
    }

    // ── Init (idempotent) ────────────────────────────────────
    async function init() {
        if (state.initialized || state.initializing) return;
        state.initializing = true;

        try {
            // 默认用本地曲目（有单曲页、完整版）；没有本地曲目才退回网易云歌单
            var playlist = config.localPlaylist || [];
            if (playlist.length === 0 && config.meting) {
                playlist = await fetchMetingData();
            }

            // 拉歌单期间页面自己换了队列（播放本地曲目 / 索引页切来源）就别覆盖它
            if (state.initialized) return;

            state.playlist = playlist;

            if (state.playlist.length > 0) {
                // Apply volume
                audio.volume = state.volume;

                var startIndex = 0;
                if (state.playMode === 2) {
                    startIndex = Math.floor(Math.random() * state.playlist.length);
                }

                state.initialized = true;

                emit('fm:init', {
                    playlist: state.playlist,
                    playMode: state.playMode
                });

                loadTrack(startIndex, false);
            } else {
                state.initialized = true;
                emit('fm:init', {
                    playlist: [],
                    playMode: state.playMode
                });
                emit('fm:error', { message: config.i18n.noSongs });
            }
        } catch (e) {
            if (state.initialized) return;
            console.error('Music Manager init error:', e);
            state.initialized = true;
            emit('fm:init', {
                playlist: [],
                playMode: state.playMode
            });
            emit('fm:error', { message: config.i18n.error });
        } finally {
            state.initializing = false;
        }
    }

    // ── Public API ───────────────────────────────────────────
    window.__musicManager = {
        init: init,
        /** 队列替换（不自动 init，也不会去拉网易云歌单） */
        setPlaylist: setPlaylist,
        /** 网易云歌单（带缓存）：索引页用它列曲目 */
        loadMeting: function () { return fetchMetingData(); },
        /** 供页面级播放器接时钟 / 频谱用 */
        getElement: function () { return audio; },
        /** 本地曲目全集（构建期注入的默认队列，和当前放的是不是它无关） */
        getLocalPlaylist: function () { return config.localPlaylist || []; },
        getState: function () {
            var track = state.playlist[state.currentIndex] || null;
            return {
                playlist: state.playlist,
                currentIndex: state.currentIndex,
                track: track,
                isPlaying: state.isPlaying,
                playMode: state.playMode,
                currentTime: audio.currentTime,
                duration: audio.duration || 0,
                progress: audio.duration ? (audio.currentTime / audio.duration) * 100 : 0,
                currentTimeStr: formatTime(audio.currentTime),
                durationStr: formatTime(audio.duration),
                lyrics: state.lyrics,
                lrcRaw: state.lrcRaw,
                lrcStatus: state.lrcStatus,
                initialized: state.initialized,
                error: state.error,
                config: config
            };
        },
        togglePlay: togglePlay,
        playNext: function () { playNext(false); },
        playPrev: playPrev,
        cyclePlayMode: cyclePlayMode,
        seek: seek,
        seekToTime: seekToTime,
        playTrackByIndex: playTrackByIndex,
        loadTrack: loadTrack,
        /** 页面控制器解析出结构后回写歌词 */
        setLyrics: setLyrics
    };
})();
</script>
